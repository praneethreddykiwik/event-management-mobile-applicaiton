# Backend API Base URL for Event Management Application
# For Localhost development (Node/Express backend running locally on port 5000):
EXPO_PUBLIC_BE_API_BASE_URL=http://localhost:5000

# For Vercel / Production deployment:
# Set EXPO_PUBLIC_BE_API_BASE_URL in Vercel Project Environment Variables to your production backend URL, e.g.:
# EXPO_PUBLIC_BE_API_BASE_URL=https://your-backend-api.com
